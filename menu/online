online(){

clear

LOG="/var/log/xray/access.log"
CONFIG="/etc/xray/config.json"

echo -e "${cyan}╭════════════════════════════════════╮${NC}"
echo -e "${cyan}│     XRAY USER ONLINE + IP LIMIT    │${NC}"
echo -e "${cyan}╰════════════════════════════════════╯${NC}"


if [ ! -f $LOG ]; then
echo -e "${red}Log Xray tidak wujud${NC}"
read -n1 -s -r -p "Back..."
menu
fi


# Ambil semua user VLESS + VMESS
users=$(grep -E "#vlg#|#vmg#" $CONFIG | awk '{print $2}' | sort -u)


if [ -z "$users" ]; then
echo -e "${red}User tidak dijumpai${NC}"
else


for user in $users
do

# cari email user dalam log
line=$(grep -B5 -A2 "email: $user" $LOG | tail -20)


if [[ -n "$line" ]]; then


IP=$(echo "$line" | grep -oE 'tcp:[0-9]{1,3}(\.[0-9]{1,3}){3}' | sed 's/tcp://' | sort -u)


if [ -z "$IP" ]; then
continue
fi


if grep -q "#vmg# $user" $CONFIG; then
TYPE="VMESS"
else
TYPE="VLESS"
fi


COUNT=$(echo "$IP" | wc -l)


echo -e "${blue}━━━━━━━━━━━━━━━━━━━━━━${NC}"

echo -e "${Lyellow}USER     :${NC} $user"
echo -e "${Lyellow}TYPE     :${NC} $TYPE"
echo -e "${Lyellow}IP ONLINE:${NC}"

echo "$IP"

echo -e "${Lyellow}TOTAL IP :${NC} $COUNT"

# IP LIMIT
if [ $COUNT -gt 1 ]; then

echo -e "STATUS   : ${red}IP LEBIH 1${NC}"

else

echo -e "STATUS   : ${Lgreen}NORMAL${NC}"

fi


fi

done

fi


echo -e "${blue}━━━━━━━━━━━━━━━━━━━━━━${NC}"

echo ""
read -n1 -s -r -p "Press any key back menu"

menu

}
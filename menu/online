online(){

clear

echo -e "${cyan}╭════════════════════════════════════╮${NC}"
echo -e "${cyan}│     XRAY USER ONLINE + IP LIMIT    │${NC}"
echo -e "${cyan}╰════════════════════════════════════╯${NC}"


LOG="/var/log/xray/access.log"
CONFIG="/etc/xray/config.json"
DB="/etc/xray/iplimit.db"


if [ ! -f $LOG ]; then
echo -e "${red}Xray log tidak dijumpai${NC}"
read -n1 -s -r -p "Back..."
menu
fi


touch $DB


users=$(grep -E "#vlg#|#vmg#" $CONFIG | awk '{print $2}' | sort -u)


if [ -z "$users" ]; then

echo -e "${red}Tiada user VLESS/VMESS dijumpai${NC}"

else


for user in $users
do


LOGUSER=$(grep "email: $user" $LOG | tail -30)


if [[ -n "$LOGUSER" ]]; then


IP=$(echo "$LOGUSER" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u)


COUNT=$(echo "$IP" | wc -l)


if grep -q "#vmg# $user" $CONFIG; then
TYPE="VMESS"
else
TYPE="VLESS"
fi



echo -e "${blue}━━━━━━━━━━━━━━━━━━━━━━${NC}"

echo -e "${Lyellow}USER     :${NC} $user"
echo -e "${Lyellow}PROTOCOL :${NC} $TYPE"

echo -e "${Lyellow}IP ONLINE:${NC}"

echo "$IP"

echo -e "${Lyellow}TOTAL IP :${NC} $COUNT"


# IP LIMIT
LIMIT="1"


OLD=$(grep "^$user|" $DB | cut -d "|" -f2)


if [ -z "$OLD" ]; then

SAVE=$(echo "$IP" | head -1)

echo "$user|$SAVE" >> $DB

echo -e "STATUS   : ${Lgreen}LOCK IP${NC}"


elif [ "$OLD" != "$(echo "$IP" | head -1)" ]; then

echo -e "STATUS   : ${red}IP BERUBAH${NC}"


else

echo -e "STATUS   : ${Lgreen}NORMAL${NC}"

fi


fi


done

fi


echo -e "${blue}━━━━━━━━━━━━━━━━━━━━━━${NC}"

read -n1 -s -r -p "Press any key back menu"

menu

}
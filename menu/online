online(){

clear

echo -e "\033[36m╭══════════════════════════════════╮\033[0m"
echo -e "\033[36m│   VLESS ONLINE + IP LIMIT        │\033[0m"
echo -e "\033[36m╰══════════════════════════════════╯\033[0m"


NGINX="/var/log/nginx/access.log"


if [ ! -f $NGINX ]; then
echo "Nginx log tiada"
read -n1
menu
fi


grep "/vless" $NGINX | tail -100 | awk '{print $1}' | sort -u > /tmp/vless-ip


if [ ! -s /tmp/vless-ip ]; then

echo "Tiada user online"

else

echo ""

echo "IP ONLINE:"
cat /tmp/vless-ip

echo ""

TOTAL=$(cat /tmp/vless-ip | wc -l)

echo "TOTAL IP : $TOTAL"

echo ""

fi


echo "=============================="

read -n1 -s -r -p "Back menu"

menu

}
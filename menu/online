online-ip(){

clear

echo -e "\033[36m╭════════════════════════════════════╮\033[0m"
echo -e "\033[36m│     XRAY ONLINE + IP LIMIT         │\033[0m"
echo -e "\033[36m╰════════════════════════════════════╯\033[0m"


LOG="/var/log/xray/access.log"

if [ ! -f $LOG ]; then
    echo "Log Xray tidak jumpa"
    read -n1
    menu
fi


echo ""

grep "email:" $LOG | tail -100 | while read line
do

USER=$(echo "$line" | awk -F'email:' '{print $2}' | awk '{print $1}')

IP=$(echo "$line" | grep -oE 'tcp:[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | cut -d: -f2)


if [[ -n $USER && -n $IP ]]; then


echo -e "\033[34m━━━━━━━━━━━━━━━━━━━━━━\033[0m"

echo -e "USER      : \033[33m$USER\033[0m"

echo -e "IP ONLINE : \033[33m$IP\033[0m"


# kira jumlah IP user
COUNT=$(grep "email: $USER" $LOG | \
grep -oE 'tcp:[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | \
cut -d: -f2 | sort -u | wc -l)


echo -e "TOTAL IP  : \033[33m$COUNT\033[0m"


# baca limit IP
if [ -f /etc/vless/${USER}IP ]; then

LIMIT=$(cat /etc/vless/${USER}IP)

else

LIMIT="1"

fi


echo -e "IP LIMIT  : \033[33m$LIMIT\033[0m"


if [ "$COUNT" -gt "$LIMIT" ]; then

echo -e "STATUS    : \033[31mOVER LIMIT\033[0m"

else

echo -e "STATUS    : \033[32mOK\033[0m"

fi


fi

done


echo ""

read -n1 -s -r -p "Press any key back menu"

menu

}
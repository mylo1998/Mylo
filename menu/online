online-ip(){

clear

echo -e "\033[36m╭════════════════════════════════════╮\033[0m"
echo -e "\033[36m│     XRAY ONLINE USER + IP LIMIT    │\033[0m"
echo -e "\033[36m╰════════════════════════════════════╯\033[0m"

LOG="/var/log/xray/access.log"
NGINX="/var/log/nginx/access.log"

if [ -f "$LOG" ]; then
    FILE=$LOG
else
    FILE=$NGINX
fi


grep "email:" $FILE | \
awk '
{
 for(i=1;i<=NF;i++)
 {
   if($i=="email:")
   {
      user=$(i+1)
   }

   if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/)
   {
      ip=$i
   }
 }

 if(user!="" && ip!="")
 {
 print user,ip
 }
}' | sort -u > /tmp/xray-online


if [ ! -s /tmp/xray-online ]; then

echo -e "\033[31mTiada user online\033[0m"

else

cat /tmp/xray-online | while read user ip
do

COUNT=$(grep "^$user " /tmp/xray-online | awk '{print $2}' | sort -u | wc -l)

echo -e "\033[34m━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "USER      : \033[33m$user\033[0m"
echo -e "IP ONLINE : \033[32m$ip\033[0m"
echo -e "IP COUNT  : $COUNT"

if [ "$COUNT" -gt 1 ]; then
echo -e "STATUS    : \033[31mOVER LIMIT\033[0m"
else
echo -e "STATUS    : \033[32mOK\033[0m"
fi

done

fi


echo ""
read -n1 -s -r -p "Tekan apa-apa untuk kembali"
menu

}
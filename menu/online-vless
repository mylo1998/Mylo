# =============================================
# CHECK USER ONLINE XRAY VLESS + VMESS + IP
# =============================================

online-ip(){

clear

echo -e "${CYAN}╭══════════════════════════════════════════╮${NC}"
echo -e "${CYAN}│        XRAY USER ONLINE + IP             │${NC}"
echo -e "${CYAN}╰══════════════════════════════════════════╯${NC}"

LOG="/var/log/xray/access.log"

if [[ ! -f $LOG ]]; then
    echo -e "${RED}LOG XRAY TIDAK ADA${NC}"
    read -n1
    menu
fi


echo ""

grep "email:" $LOG | tail -200 | while read line
do

USER=$(echo "$line" | grep -oE 'email: [^ ]+' | awk '{print $2}')

IP=$(echo "$line" | grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}' | head -1)

TIME=$(echo "$line" | awk '{print $1,$2}')


if [[ ! -z "$USER" ]]; then

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "USERNAME : ${YELLOW}$USER${NC}"
echo -e "IP LOGIN : ${GREEN}$IP${NC}"
echo -e "TIME     : ${WHITE}$TIME${NC}"

fi

done


echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━${NC}"

echo ""
read -n1 -s -r -p "Press any key back menu"

menu

}